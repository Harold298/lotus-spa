/* =====================================================
   Lotus Head Spa - Hoja de estilos
   ===================================================== */

:root {
  --morado-fondo: #4E2A74;    /* Fondo morado profundo */
  --morado-oscuro: #311856;   
  --morado-tarjeta: rgba(255, 255, 255, 0.08); /* Fondo semitransparente tipo cristal */
  --dorado: #DDB14A;          /* Dorado del logo */
  --texto-blanco: #EBE5F2;
  --texto-atenuado: #C2B3D6;

  --fuente-titulos: "Cormorant Garamond", Georgia, serif;
  --fuente-texto: "Montserrat", Arial, sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--fuente-texto);
  color: var(--texto-blanco);
  background-color: var(--morado-fondo);
  line-height: 1.6;
}

a {
  color: inherit;
}

/* Header */
.encabezado {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px 24px;
  padding: 16px 32px;
  background: var(--morado-oscuro);
  position: sticky;
  top: 0;
  z-index: 10;
}

.marca {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.logo-nav {
  color: var(--dorado);
}

.marca-nombre {
  font-family: var(--fuente-titulos);
  font-size: 1.6rem;
  color: var(--texto-blanco);
}

.menu {
  display: flex;
  gap: 20px;
}

.menu a {
  text-decoration: none;
  font-size: 0.9rem;
  letter-spacing: 1px;
}

.menu a:hover {
  color: var(--dorado);
}

/* Hero */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12px;
  min-height: 80vh;
  padding: 40px 20px;
}

.logo-hero {
  color: var(--dorado);
  margin-bottom: 10px;
}

.hero h1 {
  font-family: var(--fuente-titulos);
  font-size: clamp(2.8rem, 6vw, 4.2rem);
  font-weight: 400;
  color: #F7F3FC;
}

.hero-sub {
  font-size: 0.8rem;
  letter-spacing: 2.5px;
  color: var(--texto-atenuado);
}

.eslogan {
  font-family: var(--fuente-titulos);
  font-size: 1.3rem;
  font-style: italic;
  color: var(--dorado);
  margin-top: 6px;
}

.boton {
  margin-top: 18px;
  padding: 10px 28px;
  background: transparent;
  border: 1px solid var(--dorado);
  color: var(--dorado);
  text-decoration: none;
  border-radius: 999px;
  font-size: 0.85rem;
  letter-spacing: 1px;
  transition: all 0.3s;
}

.boton:hover {
  background: var(--dorado);
  color: var(--morado-oscuro);
}

/* Secciones generales */
.seccion {
  padding: 60px 20px;
  text-align: center;
}

.seccion h2 {
  font-family: var(--fuente-titulos);
  font-size: 2.2rem;
  color: var(--dorado);
  margin-bottom: 12px;
}

.intro {
  max-width: 600px;
  margin: 0 auto;
  color: var(--texto-atenuado);
}

/* ---------- CARTA DE SERVICIOS (Estilo Imagen 3) ---------- */
.seccion-menu {
  display: flex;
  justify-content: center;
  padding: 40px 16px 80px;
}

.tarjeta-menu {
  background: var(--morado-tarjeta);
  border: 1px solid rgba(221, 177, 74, 0.25);
  backdrop-filter: blur(8px);
  border-radius: 16px;
  padding: 48px 36px;
  width: 100%;
  max-width: 650px;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.logo-carta {
  color: var(--dorado);
  margin-bottom: 8px;
}

.titulo-menu {
  font-family: var(--fuente-titulos);
  font-size: 2.4rem;
  letter-spacing: 3px;
  font-weight: 400;
  color: #FFFFFF;
}

.subtitulo-menu {
  font-size: 0.85rem;
  letter-spacing: 1px;
  color: var(--texto-atenuado);
  margin-bottom: 30px;
}

.item-menu {
  margin-bottom: 22px;
  text-align: left;
}

.item-linea {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  font-size: 0.9rem;
  letter-spacing: 0.5px;
}

.item-nombre {
  font-weight: 500;
  color: #FFFFFF;
  flex: 1;
}

.item-duracion {
  color: var(--texto-atenuado);
  font-size: 0.8rem;
  text-transform: uppercase;
}

.item-precio {
  font-weight: 400;
  color: #FFFFFF;
  text-align: right;
  min-width: 60px;
}

.item-precio s {
  color: var(--texto-atenuado);
  font-size: 0.8rem;
  margin-left: 4px;
}

.precio-rebajado {
  color: var(--dorado);
  font-weight: 600;
}

.item-descripcion {
  font-size: 0.8rem;
  color: var(--texto-atenuado);
  margin-top: 3px;
}

.divisor-estrellas {
  margin: 32px 0 24px;
  position: relative;
  text-align: center;
}

.divisor-estrellas::before,
.divisor-estrellas::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 25%;
  height: 1px;
  background: rgba(221, 177, 74, 0.3);
}

.divisor-estrellas::before { left: 0; }
.divisor-estrellas::after { right: 0; }

.divisor-estrellas span {
  font-size: 0.8rem;
  letter-spacing: 1.5px;
  color: var(--dorado);
  padding: 0 10px;
}

/* Contacto y Pie */
.datos {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 16px;
}

.datos a {
  color: var(--dorado);
}

.pie {
  text-align: center;
  padding: 24px;
  background: var(--morado-oscuro);
  font-size: 0.8rem;
  color: var(--texto-atenuado);
}

@media (max-width: 500px) {
  .tarjeta-menu {
    padding: 32px 20px;
  }

  .item-linea {
    flex-direction: column;
    gap: 4px;
  }

  .item-precio {
    text-align: left;
  }
}